NODE_ENV=production
LIVELIFT_APP_ORIGIN=https://livelift.example.com
LIVELIFT_WORKSPACE_ID=<installation-uuid>
LIVELIFT_ROOM_ID=<room-id>
LIVELIFT_DB_PATH=/var/lib/livelift/authority.sqlite

# Administrator backup configuration; secret material stays in protected files.
LIVELIFT_BACKUP_DIR=/var/backups/livelift
RESTIC_REPOSITORY=<off-host-sftp-repository>
RESTIC_PASSWORD_FILE=<protected-password-file>

# Optional TikTok Login Kit connection (docs/tiktok/SANDBOX-SETUP.md). Leave unset to keep TikTok "Not configured".
# Placeholders only: keep real values in the protected administrator environment file, never in git.
LIVELIFT_TIKTOK_CLIENT_KEY=<tiktok-client-key>
LIVELIFT_TIKTOK_CLIENT_SECRET=<tiktok-client-secret>
# Must equal LIVELIFT_APP_ORIGIN + /api/v3/integrations/tiktok/callback and be registered, exactly, in the TikTok developer portal.
LIVELIFT_TIKTOK_REDIRECT_URI=https://livelift.example.com/api/v3/integrations/tiktok/callback
# 32 random bytes, base64. Generate once: openssl rand -base64 32. Losing it makes stored TikTok tokens unreadable (reconnect to recover).
LIVELIFT_PROVIDER_ENCRYPTION_KEY=<base64-of-32-random-bytes>
# Optional. Comma-separated; default user.info.basic. user.info.profile needs TikTok approval. No other scopes are accepted.
# LIVELIFT_TIKTOK_SCOPES=user.info.basic
# Optional. Default: provider-credentials.sqlite beside LIVELIFT_DB_PATH (not part of authority backups).
# LIVELIFT_PROVIDER_DB_PATH=/var/lib/livelift/provider-credentials.sqlite
